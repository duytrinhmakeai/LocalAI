# .gitignore for LocalAI Implementation

# Models and backends (large files)
models/*.gguf
models/*.ggml
models/*.bin
models/*.safetensors
models/*.pth
backends/*
!backends/README.md
!models/README.md

# Backups
backups/
*.tar.gz
*.zip

# Docker volumes and data
docker-data/
.docker/

# Environment and secrets
.env.local
.env.production
**/api_keys.json
!configuration/api_keys.json

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE files
.idea/
*.iml
.vscode/settings.json
.vscode/launch.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
ENV/

# Node
node_modules/
npm-debug.log*

# Temporary files
*.tmp
tmp/
temp/
*.cache

# Build artifacts
dist/
build/
*.egg-info/

# System files
.Trash-*
.nfs*

# Docker
.dockerignore.bak

# Certificates
*.pem
*.key
*.crt
!custom-ca-certs/.gitkeep

# Local configuration overrides
docker-compose.override.yml
docker-compose.local.yml
