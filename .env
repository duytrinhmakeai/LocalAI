# LocalAI Configuration Environment Variables

# Basic Configuration
MODELS_PATH=./models
BACKENDS_PATH=./backends
DEBUG=true
THREADS=4
CONTEXT_SIZE=2048
UPLOAD_LIMIT=20

# API Configuration
API_KEY=
PORT=8080
ADDRESS=:8080

# Model Configuration
GPU_LAYERS=0
LOW_VRAM=false
SINGLE_ACTIVE_BACKEND=false

# Gallery Configuration
GALLERIES='[{"name": "localai", "url": "github:mudler/LocalAI/gallery/index.yaml"}]'

# Backend Configuration
REBUILD=false
BUILD_TYPE=cpu

# P2P Configuration
P2P_TOKEN=
FEDERATED=false
WORKER=false

# Security
CORS=false
CORS_ALLOW_ORIGINS=*