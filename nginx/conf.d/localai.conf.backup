# LocalAI Configuration for localai.makeai.vn

upstream localai_backend {
    server localai:8080;
    keepalive 32;
}

# HTTP Server - Redirect to HTTPS (uncomment when you have SSL)
# server {
#     listen 80;
#     server_name localai.makeai.vn;
#     return 301 https://$server_name$request_uri;
# }

# HTTP Server (for testing without SSL)
server {
    listen 80;
    server_name localai.makeai.vn;

    # Access and error logs
    access_log /var/log/nginx/localai-access.log;
    error_log /var/log/nginx/localai-error.log;

    # Client body size
    client_max_body_size 100M;

    # Timeouts
    proxy_connect_timeout 300s;
    proxy_send_timeout 300s;
    proxy_read_timeout 300s;
    send_timeout 300s;

    # WebSocket support
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";

    # Proxy headers
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $server_name;

    # Root location
    location / {
        proxy_pass http://localai_backend;
        proxy_buffering off;
    }

    # API endpoints
    location /v1/ {
        proxy_pass http://localai_backend/v1/;
        proxy_buffering off;
    }

    # Health check
    location /readyz {
        proxy_pass http://localai_backend/readyz;
        access_log off;
    }

    # Swagger UI
    location /swagger/ {
        proxy_pass http://localai_backend/swagger/;
    }

    # Static files
    location /static/ {
        proxy_pass http://localai_backend/static/;
        expires 1d;
        add_header Cache-Control "public, immutable";
    }
}

